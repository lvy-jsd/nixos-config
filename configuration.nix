# NixOS configuration for ilo's HP EliteBook 845 G9 (host: nixos).
#
#   Desktop   niri (Wayland compositor) + Noctalia shell, SDDM login, Catppuccin Frappe
#   Terminal  kitty + fish + starship (their dotfiles live in ~/.config, not in this repo)
#
#   Rebuild   sudo nixos-rebuild switch --flake ~/nixos-config#nixos
#   Roll back sudo nixos-rebuild switch --rollback
#   Options   https://search.nixos.org/options  or  man configuration.nix
{
  lib,
  pkgs,
  inputs,
  ...
}:

let
  user = "ilo";
  flakeDir = "/home/${user}/nixos-config";
  locale = "en_US.UTF-8";

  # One cursor theme shared by niri, SDDM and the shell/lock-screen processes.
  cursor = {
    theme = "catppuccin-frappe-mauve-cursors";
    size = 24;
  };
in
{
  imports = [
    ./hardware-configuration.nix # generated by nixos-generate-config
    ./modules/mihomo-local.nix
  ];

  # ---------------------------------------------------------------------------
  # Boot
  # ---------------------------------------------------------------------------
  boot = {
    loader = {
      systemd-boot = {
        enable = true;
        configurationLimit = 5; # keep only the last 5 generations in the boot menu
      };
      efi.canTouchEfiVariables = true;
    };

    kernelPackages = pkgs.linuxPackages_latest;
    kernelModules = [ "vhost_vsock" ]; # vsock for virtual machines (/dev/kvm comes from the kvm group)

    # Encrypted swap partition. The root partition's LUKS entry is in hardware-configuration.nix.
    initrd.luks.devices."luks-80e95802-797d-480e-922c-2d0b203fd127".device =
      "/dev/disk/by-uuid/80e95802-797d-480e-922c-2d0b203fd127";
  };

  # ---------------------------------------------------------------------------
  # Networking, time and language
  # ---------------------------------------------------------------------------
  networking = {
    hostName = "nixos";
    networkmanager.enable = true;
  };

  time.timeZone = "Australia/Perth";

  i18n = {
    defaultLocale = locale;
    extraLocaleSettings = lib.genAttrs [
      "LC_ADDRESS"
      "LC_IDENTIFICATION"
      "LC_MEASUREMENT"
      "LC_MONETARY"
      "LC_NAME"
      "LC_NUMERIC"
      "LC_PAPER"
      "LC_TELEPHONE"
      "LC_TIME"
    ] (_: locale);

    # Chinese input: fcitx5 with Rime (rime-ice dictionary).
    inputMethod = {
      enable = true;
      type = "fcitx5";
      fcitx5 = {
        waylandFrontend = true;
        addons = with pkgs; [
          (fcitx5-rime.override {
            rimeDataPkgs = [
              rime-data
              rime-ice
            ];
          })
          fcitx5-gtk
          catppuccin-fcitx5
        ];
      };
    };
  };

  # ---------------------------------------------------------------------------
  # User account
  # ---------------------------------------------------------------------------
  users.users.${user} = {
    isNormalUser = true;
    description = user;
    extraGroups = [
      "networkmanager"
      "wheel" # sudo
      "kvm"
    ];
  };

  # ---------------------------------------------------------------------------
  # niri config
  #
  # The real directory lives in this repo as niri/; ~/.config/niri is a symlink
  # to it. Deliberately NOT home-manager / xdg.configFile, because that would
  # make config.kdl a read-only /nix/store symlink -- every niri tweak would
  # then need a commit plus a nixos-rebuild. This keeps the file writable
  # (niri reloads on save) while still being versioned by git.
  #
  # Why a *directory* symlink and not a file symlink: editors save atomically
  # (write temp file, then rename over the target). Doing that to a symlinked
  # file silently replaces the symlink with a plain file, detaching it from git
  # without any error. With the directory symlinked, config.kdl is a real file
  # inside the repo and atomic saves work normally.
  #
  # This activation script recreates the symlink on a fresh clone or if it gets
  # lost. An existing real directory is never overwritten.
  # ---------------------------------------------------------------------------
  system.activationScripts.niriConfig = {
    deps = [ "users" ];
    text = ''
      cfgPath=/home/${user}/.config/niri
      src=${flakeDir}/niri

      if [ -e "$src/config.kdl" ]; then
        if [ -L "$cfgPath" ] || [ ! -e "$cfgPath" ]; then
          ln -sfn "$src" "$cfgPath"
          chown -h ${user}:users "$cfgPath" 2>/dev/null || true
        else
          echo "niriConfig: $cfgPath is a real directory, leaving it untouched" >&2
        fi
      else
        echo "niriConfig: $src/config.kdl is missing, skipping symlink" >&2
      fi
    '';
  };

  # ---------------------------------------------------------------------------
  # Nix itself: flakes, garbage collection and weekly automatic upgrades
  # ---------------------------------------------------------------------------
  nixpkgs.config.allowUnfree = true; # Chrome, WeChat, QQ

  nix = {
    settings.experimental-features = [
      "nix-command"
      "flakes"
    ];
    gc = {
      automatic = true;
      dates = "weekly";
      options = "--delete-older-than 14d";
    };
    optimise.automatic = true; # hard-link identical files in the store
  };

  system.autoUpgrade = {
    enable = true;
    flake = flakeDir;
    flags = [ "--print-build-logs" ];
    dates = "weekly";
    randomizedDelaySec = "45min";
    allowReboot = false; # new generation is applied on the next manual reboot
  };

  # Refresh flake.lock right before each upgrade. This updates every input,
  # including the third-party claude-desktop and codex-desktop-linux flakes.
  systemd.services.flake-update = {
    description = "Update flake.lock before the system upgrade";
    wants = [ "network-online.target" ];
    after = [ "network-online.target" ];
    serviceConfig = {
      Type = "oneshot";
      User = user;
      WorkingDirectory = flakeDir;
    };
    path = [
      pkgs.nix
      pkgs.git
    ];
    script = "nix flake update";
  };

  systemd.services.nixos-upgrade = {
    requires = [ "flake-update.service" ];
    after = [ "flake-update.service" ];
  };

  # ---------------------------------------------------------------------------
  # Desktop: fonts and environment (niri and SDDM are enabled under programs / services below)
  # ---------------------------------------------------------------------------
  fonts = {
    enableDefaultPackages = true;
    packages = with pkgs; [
      jetbrains-mono
      lxgw-wenkai # Chinese UI font
      nerd-fonts.jetbrains-mono # kitty font_family and the starship prompt glyphs
      twemoji-color-font
    ];

    # Without these, Han glyphs fall back to the KR/HK variants of Noto CJK.
    fontconfig.defaultFonts = {
      sansSerif = [ "Noto Sans CJK SC" ];
      serif = [ "Noto Serif CJK SC" ];
      monospace = [
        "JetBrainsMono Nerd Font"
        "Noto Sans Mono CJK SC"
      ];
    };
  };

  environment.sessionVariables = {
    NIXOS_OZONE_WL = "1"; # Electron/Chromium apps use Wayland

    # niri's cursor{} block only reaches niri itself; shell and lock-screen
    # processes need these to draw a pointer.
    XCURSOR_THEME = cursor.theme;
    XCURSOR_SIZE = toString cursor.size;

    # org.gnome.desktop.* schemas live under share/gsettings-schemas/<name>/, not
    # share/glib-2.0/, so /run/current-system/sw never exposes them on its own.
    GSETTINGS_SCHEMA_DIR = "${pkgs.gsettings-desktop-schemas}/share/gsettings-schemas/${pkgs.gsettings-desktop-schemas.name}/glib-2.0/schemas";
  };

  # ---------------------------------------------------------------------------
  # Hardware, login screen and system services
  # ---------------------------------------------------------------------------
  hardware = {
    graphics.enable = true;
    bluetooth.enable = true;
  };

  security = {
    polkit.enable = true;
    rtkit.enable = true; # realtime priority for PipeWire (silences the RTKit errors)
  };

  services = {
    # Login screen: SDDM on Wayland with the Catppuccin theme (package: catppuccin-sddm).
    displayManager.sddm = {
      enable = true;
      wayland.enable = true;
      theme = "catppuccin-frappe-mauve";
      settings.Theme = {
        CursorTheme = cursor.theme;
        CursorSize = cursor.size;
      };
    };

    xserver.xkb = {
      layout = "au"; # Australian keyboard layout (also used by niri and SDDM)
      variant = "";
    };

    upower.enable = true; # battery status
    power-profiles-daemon.enable = true; # performance / balanced / power-saver
    gvfs.enable = true; # trash, network mounts in Nautilus
    udisks2.enable = true; # mount USB drives without root
  };

  # ---------------------------------------------------------------------------
  # Programs
  # ---------------------------------------------------------------------------
  programs = {
    niri.enable = true; # session config: ~/.config/niri/config.kdl
    dconf.enable = true; # gsettings backend, so GTK settings persist
    git = {
      enable = true;
      config.safe.directory = flakeDir; # the repo is owned by ilo but read by root during upgrades
    };
    nix-ld.enable = true; # run prebuilt binaries that expect a normal Linux layout
    appimage = {
      enable = true;
      binfmt = true; # run .AppImage files directly
    };
    starship.enable = true; # prompt config: ~/.config/starship.toml
    fish.enable = true; # only used by kitty (kitty.conf `shell`); the login shell stays bash
  };

  # ---------------------------------------------------------------------------
  # Flatpak + Steam
  #
  # Steam comes from Flathub rather than nixpkgs. The Flatpak build ships its own
  # runtime (freedesktop 26.08 + Mesa 26.2.5, including the 32-bit GL extension),
  # so it does not depend on the host's Mesa version and Proton games get a
  # consistent library set.
  #
  # services.flatpak (nixpkgs module) provides the plumbing:
  #   * the flatpak CLI, fuse3 and the flatpak system user
  #   * services.dbus.packages -> registers org.freedesktop.Flatpak on the session
  #     bus. Without it flatpak-spawn --sandbox fails, which is what made the
  #     runtime's glycin image loaders die and took zenity (and Steam) down.
  #   * environment.profiles -> ~/.local/share/flatpak/exports and
  #     /var/lib/flatpak/exports land on XDG_DATA_DIRS. Those are session
  #     variables, so a rebuild alone does not refresh them: log out and back in
  #     (or reboot) before the Steam entry shows up in the launcher.
  #   * fonts.fontDir -> sandboxed apps can see the system fonts.
  # ---------------------------------------------------------------------------
  services.flatpak = {
    enable = true;

    # Apps are declared here instead of installed by hand (nix-flatpak module).
    # A rebuild installs anything missing; it is convergent, not destructive.
    packages = [ "com.valvesoftware.Steam" ];

    # The Flathub manifest only grants devices=dri;kvm;shm, which leaves the
    # sandbox with no /dev/input at all. Steam reads /dev/input/event* to see
    # gamepads and writes /dev/uinput for the virtual controllers Steam Input
    # emulates, so widen it to "all". Keyboard and mouse keep working through
    # the Wayland socket either way -- this is only about raw HID devices.
    overrides = {
      "com.valvesoftware.Steam".Context.devices = [ "all" ];
    };
  };

  # udev rules for gamepads, the Steam Controller and VR headsets. Valve's
  # 60-steam-input.rules also tags /dev/uinput with "uaccess", which is what
  # grants the logged-in user write access to it -- Steam needs that to create
  # virtual controllers (Steam Input) and it silences the wrapper's warning.
  hardware.steam-hardware.enable = true;

  # ---------------------------------------------------------------------------
  # System packages
  # ---------------------------------------------------------------------------
  environment.systemPackages = with pkgs; [
    # Terminal and command-line tools
    kitty
    vim
    wget
    git
    gh # GitHub CLI; also the git credential helper for https pushes (gh auth setup-git)
    btop
    ripgrep
    fd
    bat
    eza # ls with icons
    zoxide # smarter cd (z)
    fzf # fuzzy finder (Ctrl+R / Ctrl+T)
    fastfetch
    jq
    yt-dlp
    ffmpeg
    rustup
    gcc

    # Desktop shell and theming
    noctalia
    (catppuccin-sddm.override {
      flavor = "frappe";
      accent = "mauve";
    })
    catppuccin-cursors.frappeMauve # cursor theme for niri, SDDM and the lock screen
    adwaita-icon-theme # GTK icon-theme is Adwaita (see gsettings); Noctalia also looks up icons here

    # Wayland helpers
    wl-clipboard
    xwayland-satellite # niri runs X11 apps through it; without it niri disables X11 support
    swaylock # fallback locker (Noctalia has its own: noctalia msg session lock)
    swayidle # idle timeout handling
    brightnessctl # brightness keys in the niri config
    playerctl # media keys in the niri config
    labwc # nested compositor used as Computer Use display 2

    # Desktop plumbing
    glib # gsettings
    gsettings-desktop-schemas # org.gnome.desktop.* schemas (GTK dark mode, icon theme)
    pulseaudio # pactl
    libnotify # notify-send
    libsecret # secret-tool: apps (e.g. Claude Desktop's Chrome import) read the keyring through it

    # Applications
    google-chrome
    nautilus
    mpv
    wechat
    qq
    telegram-desktop
    bilibili
    (pkgs.callPackage ./pkgs/novel-studio { }) # 小说工坊: offline fiction writing desk (see pkgs/novel-studio)
    (pkgs.callPackage ./pkgs/authorwrite { }) # 阅文作家助手: Yuewen's official web-novel client (see pkgs/authorwrite)
    inputs.claude-desktop.packages.x86_64-linux.default
    inputs.codex-desktop-linux.packages.x86_64-linux.codex-desktop
  ];

  # Do not change after the first install: it keeps stateful data compatible
  # (see `man configuration.nix` or the stateVersion option in the NixOS manual).
  system.stateVersion = "26.11";
}
